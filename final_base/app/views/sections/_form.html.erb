<%= form_with(model: section, local: true) do |form| %>
  <% if section.errors.any? %>
    <div id="error_explanation">
      <h2><%= pluralize(section.errors.count, "error") %> prohibited this section from being saved:</h2>

      <ul>
      <% section.errors.full_messages.each do |message| %>
        <li><%= message %></li>
      <% end %>
      </ul>
    </div>
  <% end %>

  <div class="field">
    <%= form.label :Section_num %>
    <%= form.text_field :Section_num, id: :section_Section_num %>
  </div>

  <div class="field">
    <%= form.label :Course_num %>
    <%= form.text_field :Course_num, id: :section_Course_num %>
  </div>

  <div class="field">
    <%= form.label :Section_semester %>
    <%= form.text_field :Section_semester, id: :section_Section_semester %>
  </div>

  <div class="field">
    <%= form.label :Section_time %>
    <%= form.text_field :Section_time, id: :section_Section_time %>
  </div>

  <div class="field">
    <%= form.label :Num_of_graders %>
    <%= form.number_field :Num_of_graders, id: :section_Num_of_graders %>
  </div>

  <div class="actions">
    <%= form.submit %>
  </div>
<% end %>
