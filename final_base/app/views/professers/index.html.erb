<p id="notice"><%= notice %></p>

<h1>Professers</h1>

<table>
  <thead>
    <tr>
      <th>Email</th>
      <th>Name</th>
      <th>Password</th>
      <th>Section num</th>
      <th>Course num</th>
      <th>Teaching year</th>
      <th>Title</th>
      <th colspan="3"></th>
    </tr>
  </thead>

  <tbody>
    <% @professers.each do |professer| %>
      <tr>
        <td><%= professer.Email %></td>
        <td><%= professer.Name %></td>
        <td><%= professer.Password %></td>
        <td><%= professer.Course_num %></td>
        <td><%= professer.Teaching_year %></td>
        <td><%= professer.Title%></td>
        <td><%= link_to 'Show', professer %></td>
        <td><%= link_to 'Edit', edit_professer_path(professer) %></td>
        <td><%= link_to 'Destroy', professer, method: :delete, data: { confirm: 'Are you sure?' } %></td>
      </tr>
    <% end %>
  </tbody>
</table>

<br>

